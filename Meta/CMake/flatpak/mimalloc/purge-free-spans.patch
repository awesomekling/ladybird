+// called from `mi_heap_collect_ex` on a forced collect: purge the free spans of the thread's segments.
+// A span that is split for a page leaves its remainder free without a scheduled purge, so the remainder
+// would otherwise keep whatever it held resident until a page is allocated from it again.
+void _mi_segments_purge_free_spans(mi_segments_tld_t* tld) {
+  for (mi_span_queue_t* sq = &tld->spans[0]; sq <= &tld->spans[MI_SEGMENT_BIN_MAX]; sq++) {
+    for (mi_slice_t* slice = sq->first; slice != NULL; slice = slice->next) {
+      mi_segment_t* segment = _mi_ptr_segment(slice);
+      mi_segment_purge(segment, mi_slice_start(slice), slice->slice_count * MI_SEGMENT_SLICE_SIZE);
+    }
+  }
+}
