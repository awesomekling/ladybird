{
    "<font-variant-css2>": {
        "spec": "https://drafts.csswg.org/css-fonts-4/#font-prop",
        "grammar": "normal | small-caps",
        "branches": [
            {
                "name": "Normal",
                "syntax": { "type": "ident", "value": "normal" }
            },
            {
                "name": "SmallCaps",
                "syntax": { "type": "ident", "value": "small-caps" }
            }
        ]
    },
    "<font-weight-absolute>": {
        "spec": "https://drafts.csswg.org/css-fonts-4/#font-weight-absolute-values",
        "grammar": "normal | bold | <number [1,1000]>",
        "branches": [
            {
                "name": "Normal",
                "syntax": { "type": "ident", "value": "normal" }
            },
            {
                "name": "Bold",
                "syntax": { "type": "ident", "value": "bold" }
            },
            {
                "name": "Number",
                "syntax": { "type": "number", "min": 1.0, "max": 1000.0 }
            }
        ],
        "__comment": "FIXME: The spec defines this wrapped in a group i.e. '[ normal | bold | <number [1,1000]> ]' but our CSS grammar parser doesn't currently know how to handle that"
    },
    "<font-width-css3>": {
        "spec": "https://drafts.csswg.org/css-fonts-4/#font-prop",
        "grammar": "normal | ultra-condensed | extra-condensed | condensed | semi-condensed | semi-expanded | expanded | extra-expanded | ultra-expanded",
        "branches": [
            {
                "name": "Normal",
                "syntax": { "type": "ident", "value": "normal" }
            },
            {
                "name": "UltraCondensed",
                "syntax": { "type": "ident", "value": "ultra-condensed" }
            },
            {
                "name": "ExtraCondensed",
                "syntax": { "type": "ident", "value": "extra-condensed" }
            },
            {
                "name": "Condensed",
                "syntax": { "type": "ident", "value": "condensed" }
            },
            {
                "name": "SemiCondensed",
                "syntax": { "type": "ident", "value": "semi-condensed" }
            },
            {
                "name": "SemiExpanded",
                "syntax": { "type": "ident", "value": "semi-expanded" }
            },
            {
                "name": "Expanded",
                "syntax": { "type": "ident", "value": "expanded" }
            },
            {
                "name": "ExtraExpanded",
                "syntax": { "type": "ident", "value": "extra-expanded" }
            },
            {
                "name": "UltraExpanded",
                "syntax": { "type": "ident", "value": "ultra-expanded" }
            }
        ]
    },
    "<symbol>": {
        "spec": "https://drafts.csswg.org/css-counter-styles-3/#typedef-symbol",
        "grammar": "<string> | <custom-ident>",
        "branches": [
            {
                "name": "String",
                "syntax": { "type": "string" }
            },
            {
                "name": "CustomIdent",
                "syntax": { "type": "custom-ident" }
            }
        ],
        "__comment": "AD-HOC: The spec actually defines this as '<string> | <image> | <custom-ident>' but the image portion is considered at-risk and no other browser supports it"
    }
}
