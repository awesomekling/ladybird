[Exposed=Nobody]
interface Internals {

    // These members deliberately remain unimplemented to test [FIXME] binding generation.
    [FIXME] undefined unimplementedOperationForTesting();
    [FIXME] readonly attribute boolean unimplementedAttributeForTesting;

    undefined signalTestIsDone(DOMString text);
    undefined setTestTimeout(double milliseconds);
    undefined forceIncompatibleVisualContextTreeRebuild();
    undefined setForceDarkEnabled(boolean enabled);
    undefined setShowLineBoxBorders(boolean enabled);
    undefined setForceDarkThresholds(long foreground, long background);
    unsigned long long visualContextTreeNodeCount();
    unsigned long long visualContextPendingDirtyBoxCount();
    unsigned long long accumulatedVisualContextIncrementalUpdateCount();
    unsigned long long visualContextTreeNodeCapacity();
    unsigned long long visualContextTreeDeadNodeCount();
    unsigned long long visualContextTreeStructuralEpoch();
    object visualContextNodeIndices(Element element);
    undefined sendMismatchedVisualContextTreeUpdateToCompositor();
    unsigned long long layoutTreePreOrderLabelViolationCount();
    unsigned long long layoutTreePreOrderRelabelCount();
    undefined loadReferenceTestMetadata();

    readonly attribute boolean hasCompletedInitialPaint;
    readonly attribute boolean initialPaintHadPendingFonts;
    // Freezes the font display clock at the given elapsed time, without starting a font load.
    undefined setFontDisplayTime(FontFace fontFace, unsigned long milliseconds);
    DOMString setTimeZone(DOMString timeZone);

    undefined gc();
    [CreatesPromise] Promise<undefined> gcAsync();
    // Clears a named environment binding and forces its current cell to be treated as garbage.
    // This does not work for values stored only in optimized locals or registers.
    undefined markAsGarbage(DOMString variableName);
    boolean wrapperIsPreserved(object object);
    boolean hasActivityRoot(object object);
    unsigned long long messagePortPendingOutgoingMessageCount(MessagePort port);
    unsigned long long htmlCollectionCacheGeneration(HTMLCollection collection);
    undefined failNextMessagePortTransfer(MessagePort port);
    boolean messagePortsAreDirectlyEntangled(MessagePort first, MessagePort second);
    XMLHttpRequest createXMLHttpRequestForDocument(Document document);
    [ImplementedAs=hit_test_result] object hitTest(double x, double y);
    object? takeContextMenuRequest();

    const unsigned short MOD_NONE = 0;
    const unsigned short MOD_ALT = 1;
    const unsigned short MOD_CTRL = 2;
    const unsigned short MOD_SHIFT = 4;
    const unsigned short MOD_SUPER = 8;
    const unsigned short MOD_KEYPAD = 16;

    const unsigned short MOD_PLATFORM_CTRL = 10; // MOD_CTRL | MOD_SUPER

    const unsigned short BUTTON_LEFT = 0;
    const unsigned short BUTTON_MIDDLE = 1;
    const unsigned short BUTTON_RIGHT = 2;

    undefined sendText(HTMLElement target, DOMString text, optional unsigned short modifiers = 0);
    undefined sendTextThroughUIProcess(DOMString text);
    undefined grantTransientActivation();
    undefined clickThroughUIProcess(double x, double y);
    undefined wheelThroughUIProcess(double x, double y, double deltaX, double deltaY);
    undefined sendKey(HTMLElement target, DOMString keyName, optional unsigned short modifiers = 0, optional unsigned long repeatCount = 1);
    undefined paste(HTMLElement target, DOMString text);
    undefined pasteFromClipboard();
    undefined commitText();

    // Low-level mouse primitives
    undefined mouseDown(double x, double y, optional unsigned short clickCount = 1, optional unsigned short button = 0, optional unsigned short modifiers = 0);
    undefined mouseDownOnScrollbarDraggedByCompositor(double x, double y, Element scroller, boolean vertical);
    undefined mouseUp(double x, double y, optional unsigned short button = 0, optional unsigned short modifiers = 0);
    undefined mouseMove(double x, double y, optional unsigned short modifiers = 0);
    undefined mouseLeave();

    // High-level mouse conveniences
    undefined click(double x, double y, optional unsigned short clickCount = 1, optional unsigned short button = 0, optional unsigned short modifiers = 0);
    undefined clickAndHold(double x, double y, optional unsigned short clickCount = 1, optional unsigned short button = 0, optional unsigned short modifiers = 0);
    [CreatesPromise] Promise<undefined> wheel(double x, double y, double deltaX, double deltaY, optional boolean precise = false, optional ScrollGesturePhase scrollGesturePhase = "none");
    undefined pinch(double x, double y, double scaleDelta, optional unsigned short modifiers = 0);
    undefined resetZoom();

    DOMString currentCursor();

    // Returns the text that would be placed on the clipboard if the user copied the current selection now.
    // Excludes nodes whose used value of user-select is 'none' — mirroring what browsers actually copy.
    DOMString selectedTextForClipboard();

    undefined setClipboardFile(DOMString name, DOMString mimeType, DOMString data);

    // Drive marked/preedit-text composition via the same path platform input methods use. setMarkedTextFromInputMethod
    // updates the inline preedit — replacing any previous preedit. commitText finalizes the composition with the given
    // text. unmarkText finalizes the composition — leaving the current preedit in place. Each fires an InputEvent with
    // inputType = "insertText" on the focused editable. All are no-ops if nothing editable is focused.
    undefined setMarkedTextFromInputMethod(DOMString text);
    undefined commitTextFromInputMethod(DOMString text, optional long replacementStart = 0, optional long replacementLength = 0);
    undefined unmarkTextFromInputMethod();

    // Returns the bounds of the current text caret in viewport-relative CSS pixels — or null if no editable element is
    // focused. Used for verifying the data the platform UI feeds into IME overlay positioning.
    DOMRect? currentCaretRect();

    boolean dispatchUserActivatedEvent(EventTarget target, Event event);
    undefined spoofCurrentURL(USVString url);

    // Loads a URL in the top-level traversable — deferred so it starts outside the calling task and can land between
    // session-history traversal-queue steps, as can one requested by ConnectionFromClient::load_url in the UI process.
    undefined loadURL(USVString url);

    InternalAnimationTimeline createInternalAnimationTimeline();

    undefined simulateDragStart(double x, double y, DOMString mimeType, DOMString contents);
    undefined simulateDragMove(double x, double y);
    undefined simulateDrop(double x, double y);

    undefined expireCookiesWithTimeOffset(long long seconds);
    Promise<undefined> deleteAllCookies();
    boolean hasCookieForURL(DOMString url, ByteString name, ByteString value);

    boolean setHttpMemoryCacheEnabled(boolean enabled);
    undefined simulateRequestServerConnectionLoss();
    undefined simulateWorkerRequestServerConnectionLoss();
    undefined sendBadIpcMessageForTesting(DOMString kind);
    undefined setContentBlockers(DOMString patterns);
    undefined setSiteCompatibilityData(DOMString source);
    undefined setContentBlockingEnabled(boolean enabled);
    unsigned long long partialLayoutCount();
    unsigned long long fullLayoutCount();
    undefined beginLayoutTrace();
    undefined updateLayoutForTesting();
    DOMString takeLayoutTrace();
    unsigned long long tableCellMeasurementCacheMissCount();
    unsigned long long intrinsicMeasurementCount();
    unsigned long long intrinsicInlineMeasurementCount();
    unsigned long long accumulatedVisualContextTreeBuildCount();
    undefined beginDisplayListTrace();
    DOMString takeDisplayListTrace();
    [ImplementedAs=recorded_async_scrolling_state_object] object recordedAsyncScrollingState();
    boolean recordedDisplayListBlocksWheelEventAt(double x, double y);
    undefined recordDisplayListForTesting(optional boolean paintOverlay = false, optional boolean cold = false);
    undefined setAutoplayPolicy(DOMString policy);

    DOMString getComputedRole(Element element);
    DOMString getComputedLabel(Element element);
    DOMString getComputedAriaLevel(Element element);
    unsigned short getEchoServerPort();

    undefined setHSTSPolicy(DOMString domain, unsigned long long maxAge, boolean includeSubDomains);
    undefined ingestHSTSHeader(USVString url, DOMString headerValue);
    boolean isKnownHSTSHost(DOMString domain);

    undefined setBrowserZoom(double factor);
    undefined setDevicePixelRatio(double ratio);

    readonly attribute boolean headless;
    readonly attribute boolean screenWakeLockActive;

    readonly attribute boolean needsRepaint;
    readonly attribute boolean needsDisplayListRecord;

    DOMString dumpDisplayList();
    DOMString dumpAccessibilityTree();
    DOMString dumpLayoutTree(Node node);
    DOMString dumpStackingContextTree();
    DOMString stackingContextStructureVerificationReport();
    DOMString dumpGCGraph();
    DOMString dumpSessionHistory();
    DOMString dumpUIProcessSessionHistory();
    DOMString dumpUIProcessSessionHistoryWithoutUpdate();
    boolean captureSessionHistorySnapshot();
    boolean restoreCapturedSessionHistorySnapshot();
    boolean registerSessionStoreTab();
    DOMString dumpSessionStoreTabState();
    DOMString dumpSiteIsolationProcessTree();
    undefined crashRemoteFrameProcesses();
    Promise<undefined> flushSessionHistoryTraversalQueue();

    boolean hasHTMLParserEndState(Document document);

    boolean hasShadowRoot(Element element);

    // Returns the shadow root of the element, if it has one, even if it's not normally accessible to JS.
    ShadowRoot? getShadowRoot(Element element);

    undefined handleSDLInputEvents();

    undefined setEnvironmentsTopLevelURL(USVString url);
    undefined setGeolocationEmulatedPosition(double latitude, double longitude, optional double accuracy = 100);

    InternalGamepad connectVirtualGamepad();

    undefined setHighlightedNode(Node? node);

    undefined clearElement(HTMLElement element);

    // Returns the number of insertions that computed an explicit child offset instead of using the append sentinel.
    unsigned long long parserNonAppendInsertions();

    // Returns a snapshot of the style engine counters exposed to LibWeb tests.
    // Keys include styleEngineReactionBatchRuns, styleEnginePublishedReactions,
    // elementStyleRecomputations, and styleEnvironmentVersion.
    [ImplementedAs=style_invalidation_counters_object] object getStyleInvalidationCounters();
    undefined resetStyleInvalidationCounters();
    // Returns what the synchronous reads of render state ("joins") in this document have cost.
    // Keys: totals, and byReason with one entry per UpdateLayoutReason that was named at least
    // once. Each holds calls, joins, cleanReads, nested, totalNanoseconds,
    // cleanReadNanoseconds, maxNanoseconds and nanosecondsSinceMutation (summed over the joins).
    [ImplementedAs=join_counters_object] object getJoinCounters();
    // LIBWEB_RENDER_CLOCK_FRAMES: the clock lease ticks the main thread adopted that installed a sample.
    unsigned long long clockTicksPresented();
    // Whether rendering updates tick clock leases: LIBWEB_RENDER_CLOCK_FRAMES is set, and the stage thread runs the
    // clock stage beside the main thread.
    boolean clockFramesEnabled();
    // LIBWEB_RENDER_CLOCK_FRAMES: the display ticks the render clock handed the stage thread, without the main thread.
    unsigned long long clockTicksReceived();
    // What the render clock did with them: ticksPosted, ticksFolded, ticksRun, ticksInstalled, ticksNeedingMain and
    // why it dropped the others.
    object getRenderClockCounters();
    // Leaves clock leases to the main thread's rendering updates, with no render clock armed, while suspended.
    undefined setRenderClockSuspended(boolean suspended);
    // Hands the leases a render clock ticks a display tick at frameTimeMs (like injectRenderingOpportunity()) once the
    // main thread goes idle, as the render clock would. Resolves with whether a lease took it, once it has run. With
    // setManualRenderingOpportunities(true, true), no display tick but these reaches the leases.
    Promise<boolean> injectClockTick(double frameTimeMs);
    undefined resetJoinCounters();
    // Prints the reasons that blocked this document the longest to the debug log.
    undefined dumpJoinCounters();
    // What keeps this document's layout in a rendering update in place rather than beside the main
    // thread ("ResizeObservation", "ViewTransition", "ScrollStateContainer",
    // "ContentVisibilityAutoFirstDetermination", "ScrollTimeline"), or "" if nothing does.
    DOMString layoutOverlapBlocker();
    object getRenderingSchedulerCounters();
    undefined resetRenderingSchedulerCounters();
    // Under LIBWEB_STAGE_THREAD=overlap, holds the next recording submitted to the render side
    // until releaseHeldFrame(), so that tasks run beside that frame in flight. Returns whether it
    // will hold one; it never does in the other modes. It holds the recording at `point`:
    // "before-run", "mid-recording" (holding the arena's paint state and scratch) or
    // "before-completion" (finished, before the main thread hears of it); with a document, only
    // that document's recording. A main-thread wait for the recording releases it too; a stage the
    // main thread would queue behind it (the layout update of a document painted after it) runs on
    // the main thread instead.
    boolean holdNextRecordingFrame(optional DOMString point = "before-run", optional Document? document = null);
    // Like holdNextRecordingFrame(), for the next full layout pass a rendering update submits, under
    // LIBWEB_STAGE_THREAD=overlap with LIBWEB_STAGE_OVERLAP naming "layout". It holds the pass at
    // "before-run" or "before-completion" (laid out, before the main thread hears of it).
    boolean holdNextLayoutFrame(optional DOMString point = "before-run", optional Document? document = null);
    // Like holdNextRecordingFrame(), for the next clock lease tick a rendering update submits under
    // LIBWEB_RENDER_CLOCK_FRAMES ("before-run" or "before-completion").
    boolean holdNextClockTick(optional DOMString point = "before-run", optional Document? document = null);
    // Like holdNextLayoutFrame(), for the first style pass a rendering update submits, under
    // LIBWEB_STAGE_THREAD=overlap with LIBWEB_STAGE_OVERLAP naming "style". It holds the pass at
    // "before-run" or "before-completion" (styled, before the main thread hears of it).
    boolean holdNextStyleFrame(optional DOMString point = "before-run", optional Document? document = null);
    // Blocks (bounded) until the stage a hold is armed for is held and returns where, or "" if none
    // is. Returns "" at once if no such stage has been submitted, since none can be while it blocks.
    DOMString waitForHeldFrame();
    // Whether a hold is armed for a stage the rendering update has not submitted yet while an earlier stage of its
    // frame is in flight (the layout pass it submits once it has taken its style pass back between tasks).
    boolean heldFrameAwaitsSubmission();
    // Whether rendering updates submit their layout pass (under LIBWEB_STAGE_THREAD=overlap with LIBWEB_STAGE_OVERLAP
    // naming "layout"), which holdNextLayoutFrame() can hold.
    boolean submitsLayoutPass();
    undefined releaseHeldFrame();
    // How many forced joins (main-thread accesses that waited for the frame in flight and took it in, or, from inside a
    // garbage collection, only waited for it) reached a frame with a stage `stage` names ("recording", "layout" or
    // "style") on this thread so far.
    unsigned long long forcedJoinCount(DOMString stage);
    // Whether a frame is in flight and holds this document.
    boolean frameInFlightHoldsDocument();
    // Whether each document a frame in flight holds, and its navigable, page and window, are alive
    // (true if none is in flight).
    boolean frameInFlightReferencesAreAlive();
    // With withClockTicks, the leases a render clock would tick take the display ticks injectClockTick() hands them.
    undefined setManualRenderingOpportunities(boolean enabled, optional boolean withClockTicks = false);
    // Whether a rendering task that finds the previous rendering update's frame in flight holds its rendering
    // opportunity instead of waiting for the frame, overriding LIBWEB_RENDERING_OPPORTUNITY_HOLD until
    // resetRenderingOpportunityHold(). A test that sets it resets it.
    undefined setRenderingOpportunityHold(boolean enabled);
    undefined resetRenderingOpportunityHold();
    // Whether the rendering task holds its rendering opportunity until the frame in flight has finished.
    boolean renderingTaskHeld();
    undefined injectRenderingOpportunity(double frameTimeMs);
    // Blocks (bounded) until the frame in flight has finished on the render side, without taking it
    // in. Returns false if no frame is in flight.
    boolean waitForFrameToFinish();
    // The frame scheduler's state: "idle", "main-half", "in-flight", "consuming" or
    // "committed-tail-pending".
    DOMString frameSchedulerState();
    // Whether the frame in flight presents the frames begun from now on (unless LIBWEB_RENDER_PRESENTS=0), overriding the
    // environment until resetRenderPresents(). A test that sets it resets it.
    undefined setRenderPresents(boolean enabled);
    undefined resetRenderPresents();
    // How many scenes this window's navigable has handed its compositor context, read without taking in the frame in
    // flight; and the epoch of the last one the main thread took in, which its hit-test list was made with.
    unsigned long long presentedSceneEpoch();
    unsigned long long hitTestSceneEpoch();
    // Whether the rendering update has submitted its style or layout pass (under LIBWEB_STAGE_OVERLAP naming "style" or
    // "layout") and goes on with the rest, which submits its recordings, once the main thread has taken the pass back
    // between tasks.
    boolean renderingUpdateAwaitsPass();
    // How many times main-thread code took a style pass in flight back before its time (a forced join), since the
    // process started. A write that queues its style input beside the pass leaves it unchanged.
    unsigned long long stylePassForcedJoins();
    undefined updateCompositorAnimations();
    boolean runEmptyAnimationStyleUpdateForTesting();
    undefined armCompositorAnimationTimersForTesting();
    undefined fireCompositorAnimationWakeupForTesting(double frameTimeMs);
    undefined forceVisualContextTreeRebuildOnNextCompositorAnimationUpdateForTesting();
    undefined requestReentrantAnimationStyleFlushForTesting(Node node);
    // Returns the confinement report of the most recent layout tree build for the current
    // document. Keys: builds (cumulative build count), lastBuildRebuiltSubtreeRoots (number of
    // subtrees rebuilt in place), lastBuildEscapedRebuildRoots (whether any tree mutation
    // escaped the rebuilt subtrees, disqualifying the build from partial relayout).
    object layoutTreeBuildStats();
    // Snapshots the current, incrementally-updated layout tree, rebuilds it from scratch, and
    // returns { matches }, plus { incremental, full } on mismatch. This is a test oracle for
    // incremental tree builds.
    object compareLayoutTreeWithFullRebuild();
    // Returns process-wide ComputedValues instance and retained representation statistics.
    // Keys: liveComputedValues, totalComputedValuesCreated,
    // retainedLegacyComputedPropertyArrayHolders, retainedLegacyComputedPropertyArrayBytes.
    object computedValuesStats();
    // Returns a snapshot of the process-wide style FFI boundary counters: one key per boundary
    // operation, counting calls into the Rust style core and callbacks it makes into C++.
    object styleFfiCounters();
    object styleEngineCounters();
    unsigned long long styleRecordIdentity(Element element);
    unsigned long long layoutStyleRecordIdentity(Element element);
    unsigned long long beforeStyleRecordIdentity(Element element);
    unsigned long long beforeLayoutStyleRecordIdentity(Element element);
    unsigned long long paintStyleRecordIdentity(Element element);
    // Stable for the lifetime of a layout node, and zero when the DOM node has no principal
    // layout node. Useful for asserting that incremental tree builds preserve unaffected nodes.
    unsigned long long layoutNodeIdentity(Node node);
    unsigned long long layoutArenaLiveSlotCount();
    unsigned long long layoutArenaShellCount();
    double styleEngineMatchDocument();
    // Reports a snapshot of StyleEngine's matched rules for the whole document.
    DOMString styleEngineMatchedRules();
    object styleEngineTransactionReactions();
    undefined resetStyleFfiCounters();
    // Returns, for each ComputedValues style value group of the given element, whether the
    // group payload is shared with the parent element, whether it is the default payload,
    // and its identity for comparisons while the computed style remains alive.
    object styleGroupSharingInfo(Element element);
    // Flushes pending style work without forcing layout.
    undefined updateStyle();
    undefined setUserStyle(DOMString source);
    undefined setPreferredColorScheme(DOMString colorScheme);
    // Simulates the window gaining or losing focus (e.g. browser chrome or another window taking focus).
    undefined setPageFocus(boolean hasFocus);
    // Simulates the page being shown or hidden (e.g. switching to another tab). Accepts "visible" or "hidden".
    undefined setSystemVisibilityState(DOMString state);
    // Overrides the interval between the wake-ups a hidden document holds its delayed timers back to (1000 ms by default).
    undefined setHiddenDocumentTimerWakeUpInterval(double milliseconds);
    // Overrides the interval between the wake-ups a hidden document holds its chained timers back to once it has been
    // hidden for the grace period, and that grace period, both in milliseconds (60000 ms and 300000 ms by default).
    undefined setHiddenDocumentIntensiveTimerThrottling(double wakeUpInterval, double gracePeriodOnceLoaded, double gracePeriodWhileLoading);
    // Returns how many timers are armed on the given window (a Window or WindowProxy object).
    unsigned long long activeTimerCount(object window);
    // Returns how many tasks sit in the main thread event loop's task queue, runnable or not.
    unsigned long long taskQueueLength();
    DOMString canvasColorScheme();
    // Returns the selector-insight cache state for stylesheet invalidation tests.
    object imageAnimationStateForURL(USVString url);
    boolean mediaElementIsFetching(HTMLMediaElement element);
    boolean mediaElementIsPlayingAudio(HTMLMediaElement element);
    boolean mediaElementVideoSinkIsTicking(HTMLMediaElement element);
    undefined setMediaElementReadyState(HTMLMediaElement element, unsigned short readyState);
    undefined setMediaElementPaused(HTMLMediaElement element, boolean paused);
    undefined setMediaElementSeeking(HTMLMediaElement element, boolean seeking);
    undefined setPageMuted(boolean muted);

    [ImplementedAs=async_scrolling_state_object] object asyncScrollingState();
    boolean asyncScrollingStateBlocksWheelEventAt(double x, double y);
    boolean asyncScrollingStateCanWheelScrollAt(double x, double y, double deltaX, double deltaY, optional boolean forceStaleWheelEventRegions = false);
    DOMString asyncScrollingStateWheelRoutingAdmission();
    DOMString asyncScrollingStateWheelScrollAdmissionAt(double x, double y, double deltaX, double deltaY, optional boolean forceStaleWheelEventRegions = false);
    DOMString asyncScrollingStateWheelTargetAt(double x, double y, double deltaX, double deltaY);
    DOMString viewportOverflowX();

};

enum ScrollGesturePhase { "none", "ongoing", "momentum", "ended" };
